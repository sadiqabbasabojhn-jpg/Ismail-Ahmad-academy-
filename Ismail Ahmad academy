<script>
  // SYSTEM STATE DATABASE
  let currentUserRole = null; // 'admin', 'classmaster', 'teacher'
  
  let students = [
    { id: "IAM/2026/001", name: "Ibrahim Sadiq", class: "JS 1", feesPaid: 30000, feesTotal: 30000, attendance: "Present", marks: { eng: 85, math: 90, sci: 78, soc: 80, rel: 88, hau: 82, comp: 95 } },
    { id: "IAM/2026/002", name: "Fatima Usman", class: "JS 1", feesPaid: 30000, feesTotal: 30000, attendance: "Present", marks: { eng: 85, math: 90, sci: 78, soc: 80, rel: 88, hau: 82, comp: 95 } },
    { id: "IAM/2026/003", name: "Zainab Abubakar", class: "JS 1", feesPaid: 15000, feesTotal: 30000, attendance: "Absent", marks: { eng: 60, math: 55, sci: 62, soc: 58, rel: 70, hau: 65, comp: 60 } }
  ];

  let notices = [
    { title: "Mid-Term Break Announcement", body: "School closes for mid-term break on March 15, 2026.", date: "2026-02-20" },
    { title: "2nd Term Fees Deadline", body: "All parents are advised to settle outstanding fees before exams.", date: "2026-02-18" }
  ];

  // AUTHENTICATION
  function attemptLogin() {
    const u = document.getElementById('loginUser').value.trim();
    const p = document.getElementById('loginPass').value.trim();

    if ((u === "admin" && p === "iama2026") || (u === "sadiqabbasabojhn@gmail.com" && p === "Sadiq001")) {
      currentUserRole = "admin";
    } else if (u === "classmaster" && p === "marks2026") {
      currentUserRole = "classmaster";
    } else if (u === "teacher" && p === "teach2026") {
      currentUserRole = "teacher";
    } else {
      alert("Invalid Username or Password!");
      return;
    }

    document.getElementById('loginSection').classList.add('hidden');
    document.getElementById('portalSection').classList.remove('hidden');
    document.getElementById('userHeaderInfo').classList.remove('hidden');
    document.getElementById('loggedInRole').innerText = "Role: " + currentUserRole.toUpperCase();

    applyRoleRestrictions();
    refreshAllData();
  }

  function logout() {
    location.reload();
  }

  function applyRoleRestrictions() {
    // Restrict Enter Marks & Admission based on role
    const marksForm = document.getElementById('marksFormContainer');
    const marksMsg = document.getElementById('marksRestrictedMsg');
    
    if (currentUserRole === 'teacher') {
      marksForm.classList.add('hidden');
      marksMsg.classList.remove('hidden');
      document.getElementById('addNoticeForm').classList.add('hidden');
      document.getElementById('tabAdmission').classList.add('hidden');
    } else if (currentUserRole === 'classmaster') {
      marksForm.classList.remove('hidden');
      marksMsg.classList.add('hidden');
      document.getElementById('tabAdmission').classList.add('hidden');
    } else {
      // Admin Access
      marksForm.classList.remove('hidden');
      marksMsg.classList.add('hidden');
      document.getElementById('tabAdmission').classList.remove('hidden');
    }
  }

  // TAB SWITCHING
  function switchTab(tabId) {
    document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
    document.querySelectorAll('.nav-tab').forEach(el => el.classList.remove('active'));
    
    document.getElementById('view-' + tabId).classList.remove('hidden');
    event.target.classList.add('active');
  }

  // CALCULATION LOGIC (GRADES & DENSE RANKING)
  function calculateStudentData(student) {
    const m = student.marks;
    const total = m.eng + m.math + m.sci + m.soc + m.rel + m.hau + m.comp;
    const avg = parseFloat((total / 7).toFixed(1));
    
    let grade = 'F';
    if (avg >= 70) grade = 'A';
    else if (avg >= 60) grade = 'B';
    else if (avg >= 50) grade = 'C';
    else if (avg >= 40) grade = 'D';
    else if (avg >= 30) grade = 'E';

    return { total, avg, grade };
  }

  function getRankings() {
    // Sort students by total score descending
    let sorted = [...students].map(s => {
      const calc = calculateStudentData(s);
      return { ...s, total: calc.total, avg: calc.avg, grade: calc.grade };
    }).sort((a, b) => b.total - a.total);

    // Apply Dense Rank (1, 1, 1, 2...)
    let currentRank = 1;
    for (let i = 0; i < sorted.length; i++) {
      if (i > 0 && sorted[i].total < sorted[i - 1].total) {
        currentRank++;
      }
      sorted[i].position = currentRank;
    }
    return sorted;
  }

  // REFRESH DATA VIEWS
  function refreshAllData() {
    renderDashboard();
    renderStudents();
    renderAttendance();
    renderFees();
    renderResults();
    populateSelects();
    renderNotices();
  }

  function renderDashboard() {
    document.getElementById('dashStudents').innerText = students.length;
    let paid = students.reduce((acc, s) => acc + s.feesPaid, 0);
    let total = students.reduce((acc, s) => acc + s.feesTotal, 0);
    document.getElementById('dashFeesPaid').innerText = '₦' + paid.toLocaleString();
    document.getElementById('dashFeesDue').innerText = '₦' + (total - paid).toLocaleString();
  }

  function renderStudents() {
    const q = document.getElementById('searchStudent').value.toLowerCase();
    const tbody = document.getElementById('studentTableBody');
    tbody.innerHTML = '';

    students.filter(s => s.name.toLowerCase().includes(q) || s.id.toLowerCase().includes(q)).forEach(s => {
      const feeStatus = s.feesPaid >= s.feesTotal ? '<span class="badge bg-green">Paid</span>' : '<span class="badge bg-red">Outstanding</span>';
      tbody.innerHTML += `<tr>
        <td>${s.id}</td>
        <td>${s.name}</td>
        <td>${s.class}</td>
        <td>${feeStatus}</td>
        <td>${s.attendance}</td>
      </tr>`;
    });
  }

  function renderAttendance() {
    const tbody = document.getElementById('attendanceTableBody');
    tbody.innerHTML = '';
    students.forEach((s, index) => {
      let badgeClass = s.attendance === 'Present' ? 'bg-green' : (s.attendance === 'Late' ? 'bg-yellow' : 'bg-red');
      tbody.innerHTML += `<tr>
        <td>${s.name}</td>
        <td>${s.class}</td>
        <td><span class="badge ${badgeClass}" style="cursor:pointer;" onclick="toggleAttendance(${index})">${s.attendance}</span></td>
      </tr>`;
    });
  }

  function toggleAttendance(index) {
    if (students[index].attendance === 'Present') students[index].attendance = 'Late';
    else if (students[index].attendance === 'Late') students[index].attendance = 'Absent';
    else students[index].attendance = 'Present';
    renderAttendance();
  }

  function renderFees() {
    const tbody = document.getElementById('feesTableBody');
    tbody.innerHTML = '';
    students.forEach((s, index) => {
      const due = s.feesTotal - s.feesPaid;
      tbody.innerHTML += `<tr>
        <td>${s.name}</td>
        <td>${s.class}</td>
        <td>₦${s.feesTotal.toLocaleString()}</td>
        <td>₦${s.feesPaid.toLocaleString()}</td>
        <td>₦${due.toLocaleString()}</td>
        <td><button onclick="payFee(${index})" class="btn-success" style="padding: 4px 8px; font-size: 11px;">Record Payment</button></td>
      </tr>`;
    });
  }

  function payFee(index) {
    let amt = prompt("Enter payment amount (₦):");
    if (amt && !isNaN(amt)) {
      students[index].feesPaid += parseInt(amt);
      refreshAllData();
    }
  }

  function renderResults() {
    const tbody = document.getElementById('resultsTableBody');
    tbody.innerHTML = '';
    const ranked = getRankings();
    ranked.forEach(r => {
      tbody.innerHTML += `<tr>
        <td><strong>${r.position}</strong></td>
        <td>${r.name}</td>
        <td>${r.total} / 700</td>
        <td>${r.avg}%</td>
        <td><span class="badge bg-green">${r.grade}</span></td>
      </tr>`;
    });
  }

  function populateSelects() {
    const mSelect = document.getElementById('marksStudentSelect');
    const rSelect = document.getElementById('reportStudentSelect');
    mSelect.innerHTML = '';
    rSelect.innerHTML = '';

    students.forEach((s, i) => {
      mSelect.innerHTML += `<option value="${i}">${s.name} (${s.class})</option>`;
      rSelect.innerHTML += `<option value="${i}">${s.name} (${s.class})</option>`;
    });
    loadStudentMarksIntoForm();
    renderReportCard();
  }

  function loadStudentMarksIntoForm() {
    const idx = document.getElementById('marksStudentSelect').value;
    if (idx === "") return;
    const m = students[idx].marks;
    document.getElementById('m_eng').value = m.eng;
    document.getElementById('m_math').value = m.math;
    document.getElementById('m_sci').value = m.sci;
    document.getElementById('m_soc').value = m.soc;
    document.getElementById('m_rel').value = m.rel;
    document.getElementById('m_hau').value = m.hau;
    document.getElementById('m_comp').value = m.comp;
  }

  function saveStudentMarks() {
    const idx = document.getElementById('marksStudentSelect').value;
    students[idx].marks = {
      eng: parseInt(document.getElementById('m_eng').value) || 0,
      math: parseInt(document.getElementById('m_math').value) || 0,
      sci: parseInt(document.getElementById('m_sci').value) || 0,
      soc: parseInt(document.getElementById('m_soc').value) || 0,
      rel: parseInt(document.getElementById('m_rel').value) || 0,
      hau: parseInt(document.getElementById('m_hau').value) || 0,
      comp: parseInt(document.getElementById('m_comp').value) || 0
    };
    alert("Marks updated and student positions recalculated!");
    refreshAllData();
  }

  function renderReportCard() {
    const idx = document.getElementById('reportStudentSelect').value;
    if (idx === "") return;
    const s = students[idx];
    const ranked = getRankings().find(r => r.id === s.id);

    let html = `
      <p><strong>Student Name:</strong> ${s.name} | <strong>Admission No:</strong> ${s.id} | <strong>Class:</strong> ${s.class}</p>
      <table>
        <thead>
          <tr><th>Subject</th><th>Score (100%)</th><th>Grade</th></tr>
        </thead>
        <tbody>
          <tr><td>English Language</td><td>${s.marks.eng}</td><td>${getSubjectGrade(s.marks.eng)}</td></tr>
          <tr><td>Mathematics</td><td>${s.marks.math}</td><td>${getSubjectGrade(s.marks.math)}</td></tr>
          <tr><td>Basic Science</td><td>${s.marks.sci}</td><td>${getSubjectGrade(s.marks.sci)}</td></tr>
          <tr><td>Social Studies</td><td>${s.marks.soc}</td><td>${getSubjectGrade(s.marks.soc)}</td></tr>
          <tr><td>IRS/CRS</td><td>${s.marks.rel}</td><td>${getSubjectGrade(s.marks.rel)}</td></tr>
          <tr><td>Hausa Language</td><td>${s.marks.hau}</td><td>${getSubjectGrade(s.marks.hau)}</td></tr>
          <tr><td>Computer Studies</td><td>${s.marks.comp}</td><td>${getSubjectGrade(s.marks.comp)}</td></tr>
        </tbody>
      </table>
      <div style="margin-top: 15px; background: #f9fafb; padding: 10px; border-radius: 6px;">
        <p style="margin: 3px 0;"><strong>Total Score:</strong> ${ranked.total} / 700</p>
        <p style="margin: 3px 0;"><strong>Average:</strong> ${ranked.avg}%</p>
        <p style="margin: 3px 0;"><strong>Overall Grade:</strong> ${ranked.grade}</p>
        <p style="margin: 3px 0;"><strong>Position in Class:</strong> ${ranked.position}</p>
      </div>
    `;
    document.getElementById('reportCardDetails').innerHTML = html;
  }

  function getSubjectGrade(score) {
    if (score >= 70) return 'A';
    if (score >= 60) return 'B';
    if (score >= 50) return 'C';
    if (score >= 40) return 'D';
    if (score >= 30) return 'E';
    return 'F';
  }

  function registerNewStudent() {
    const name = document.getElementById('admName').value;
    const id = document.getElementById('admId').value;
    const cls = document.getElementById('admClass').value;

    if (!name || !id) {
      alert("Please fill in Student Name and Admission Number!");
      return;
    }

    students.push({
      id: id,
      name: name,
      class: cls,
      feesPaid: 0,
      feesTotal: 30000,
      attendance: "Present",
      marks: { eng: 0, math: 0, sci: 0, soc: 0, rel: 0, hau: 0, comp: 0 }
    });

    alert("Student " + name + " registered successfully!");
    document.getElementById('admName').value = '';
    document.getElementById('admId').value = '';
    refreshAllData();
  }

  function publishNotice() {
    const t = document.getElementById('noticeTitle').value;
    const b = document.getElementById('noticeBody').value;
    if (!t || !b) return;

    notices.unshift({ title: t, body: b, date: new Date().toISOString().split('T')[0] });
    document.getElementById('noticeTitle').value = '';
    document.getElementById('noticeBody').value = '';
    renderNotices();
  }

  function renderNotices() {
    const container = document.getElementById('noticesContainer');
    const dashContainer = document.getElementById('dashNoticeList');
    container.innerHTML = '';
    dashContainer.innerHTML = '';

    notices.forEach(n => {
      const card = `<div style="background:#f8fafc; padding:10px; margin-bottom:10px; border-left:3px solid var(--primary); border-radius:4px;">
        <h4 style="margin:0;">${n.title} <small style="font-size:10px; color:#6b7280;">(${n.date})</small></h4>
        <p style="margin:5px 0 0; font-size:13px;">${n.body}</p>
      </div>`;
      container.innerHTML += card;
      dashContainer.innerHTML += card;
    });
  }
</script>

</body>
</html>
