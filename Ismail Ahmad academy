<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ismail Ahmad Memorial Academy — School Management System</title>
  <style>
    :root {
      --primary: #1e3a8a;
      --secondary: #059669;
      --warning: #d97706;
      --danger: #dc2626;
      --bg: #f3f4f6;
      --card: #ffffff;
      --text: #1f2937;
    }
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg); color: var(--text); margin: 0; padding: 0; }
    .header { background: var(--primary); color: white; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; }
    .header h1 { margin: 0; font-size: 18px; }
    .header p { margin: 2px 0 0; font-size: 12px; opacity: 0.8; }
    
    .container { max-width: 1100px; margin: 20px auto; padding: 0 15px; }
    .card { background: var(--card); padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-bottom: 20px; }
    
    /* Navigation Tabs */
    .nav-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; background: #e5e7eb; padding: 8px; border-radius: 8px; }
    .nav-tab { padding: 8px 14px; background: transparent; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; color: #4b5563; font-size: 13px; }
    .nav-tab.active { background: var(--primary); color: white; }
    
    /* UI Components */
    input, select, textarea, button { width: 100%; padding: 10px; margin-top: 6px; margin-bottom: 12px; border-radius: 6px; border: 1px solid #d1d5db; box-sizing: border-box; font-family: inherit; }
    button { background: var(--primary); color: white; border: none; font-weight: bold; cursor: pointer; }
    button:hover { opacity: 0.9; }
    .btn-danger { background: var(--danger); }
    .btn-success { background: var(--secondary); }
    
    /* Data Tables */
    table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
    th, td { border: 1px solid #e5e7eb; padding: 10px; text-align: left; }
    th { background: #f9fafb; color: var(--primary); }
    
    .hidden { display: none !important; }
    .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; }
    .stat-card { background: #f8fafc; border-left: 4px solid var(--primary); padding: 15px; border-radius: 6px; }
    .stat-card h4 { margin: 0; font-size: 12px; color: #6b7280; }
    .stat-card h2 { margin: 5px 0 0; color: var(--primary); }
    
    .badge { padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: bold; display: inline-block; }
    .bg-green { background: #d1fae5; color: #065f46; }
    .bg-red { background: #fee2e2; color: #991b1b; }
    .bg-yellow { background: #fef3c7; color: #92400e; }
    
    .footer { text-align: center; margin-top: 40px; font-size: 12px; color: #6b7280; padding: 15px; border-top: 1px solid #e5e7eb; }
    
    /* Printable Report Card Styles */
    @media print {
      body * { visibility: hidden; }
      #printableArea, #printableArea * { visibility: visible; }
      #printableArea { position: absolute; left: 0; top: 0; width: 100%; }
    }
  </style>
</head>
<body>

