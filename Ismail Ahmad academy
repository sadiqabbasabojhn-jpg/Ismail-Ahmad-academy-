          <tr><td>Thursday</td><td>Social Studies</td><td>IRS/CRS</td><td>Mathematics</td><td>Hausa</td></tr>
          <tr><td>Friday</td><td>Hausa</td><td>Computer</td><td>Islamic Studies</td><td>Revision</td></tr>
