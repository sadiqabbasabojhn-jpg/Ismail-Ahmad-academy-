        </thead>
        <tbody>
          <tr><td>Sadiq Abbas</td><td>Proprietor / Super Admin</td><td>Management</td><td>+234 800 000 0000</td></tr>
          <tr><td>Malam Aminu Jahun</td><td>Class Master</td><td>Mathematics & Computer</td><td>+234 801 111 2222</td></tr>
          <tr><td>Aisha Bello</td><td>Teacher</td><td>English Language</td><td>+234 802 333 4444</td></tr>
